// Firestore-regels voor de bekijk-link (?deel=...)
//
// Plak deze blokken in de Firebase console → Firestore Database → Regels,
// BINNEN  match /databases/{database}/documents { ... }  naast je bestaande regels.
// Je bestaande regels blijven werken: Firestore geeft toegang als minstens één regel "ja" zegt.

    // Wie de link heeft, mag dat ene document lezen (niet de lijst van alle links).
    match /publicShares/{token} {
      allow get: if true;
      allow create, update: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Locaties en producten mogen gelezen worden zolang de eigenaar de bekijk-link aan heeft staan.
    match /vriezers/{id} {
      allow read: if get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('publicShareEnabled', false) == true;
    }
    match /items/{id} {
      allow read: if get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('publicShareEnabled', false) == true;
    }
