# Kopieer dit bestand naar .env en pas aan.

# Hoe laat de dagelijkse melding vertrekt (24-uursnotatie, Belgische tijd)
MELDING_UUR=08:00

# Adres van je app (voor de link in de melding)
APP_URL=https://voorraad.github.io/voorraad-app/

# Een e-mailadres van jou (wordt meegestuurd naar de pushdiensten, verplicht door de standaard)
CONTACT=mailto:jouw-adres@voorbeeld.be

# ---- Enkel voor foto-opslag ----
# Het publieke https-adres van deze server (bv. https://voorraad.tail1234.ts.net via Tailscale Funnel). Leeg = foto's blijven zoals nu.
PUBLIC_URL=
# Welke websites mogen foto's uploaden
ALLOWED_ORIGINS=https://voorraad.github.io
# Enkel bij Docker: token van je Cloudflare Tunnel
TUNNEL_TOKEN=

# ---- Automatische back-up (elke nacht, in data/backups) ----
BACKUP_UUR=03:00
BACKUP_DAGEN=30

# ---- Dagrapport per mail (optioneel) ----
# Bv. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=jij@gmail.com, SMTP_PASS=een app-wachtwoord
# (Google-account → Beveiliging → App-wachtwoorden). Aan wie en hoe laat kies je in de app (beheerpagina).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_VAN=
