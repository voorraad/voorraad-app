// Firestore-regels voor de beheerpagina
//
// Plak deze blokken in de Firebase console → Firestore Database → Regels,
// BINNEN  match /databases/{database}/documents { ... }  naast je bestaande regels.
// Firestore geeft toegang als minstens één regel "ja" zegt, je bestaande regels blijven dus werken.

    // Notities per gebruiker: enkel admins mogen ze lezen en schrijven.
    match /adminNotes/{uid} {
      allow read, write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Mededeling bovenaan de app: iedereen die ingelogd is mag lezen, enkel admins schrijven.
    match /settings/mededeling {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
