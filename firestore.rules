rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Ingelogde gebruikers mogen lezen en schrijven (zoals voorheen),
    // behalve de notities van de beheerders.
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null && collection != 'adminNotes';
    }

    // Notities per gebruiker: alleen voor beheerders.
    match /adminNotes/{uid} {
      allow read, write: if isAdmin();
    }

    // Bekijk-link (?deel=...): wie de link heeft, mag zonder account
    // dat ene link-document lezen (niet de lijst van alle links)...
    match /publicShares/{token} {
      allow get: if true;
    }
    // ...en de locaties en producten van die eigenaar, zolang de link aan staat.
    match /vriezers/{id} {
      allow read: if get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('publicShareEnabled', false) == true;
    }
    match /items/{id} {
      allow read: if get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get('publicShareEnabled', false) == true;
    }
  }
}
